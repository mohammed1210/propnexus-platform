name: Backend Sanity Check

on:
  push:
    branches: [main, po3/stripe-paywall-tiers]
  pull_request:
    branches: [main, po3/stripe-paywall-tiers]

jobs:
  sanity-test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          python -m venv venv
          source venv/bin/activate
          pip install -r requirements.txt

      - name: Verify backend.main imports
        run: |
          source venv/bin/activate
          python - <<'PY'
          import sys, importlib
          sys.path.insert(0, ".")
          try:
              importlib.import_module("backend.main")
              print("✅ backend.main import successful.")
          except Exception as e:
              print("❌ backend.main failed to import:")
              raise
          PY

      - name: Report success
        if: success()
        run: echo "All good — backend package loads cleanly."