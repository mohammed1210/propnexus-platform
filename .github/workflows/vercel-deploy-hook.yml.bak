name: Deploy Frontend (Vercel Hook)

on:
  push:
    branches:
      - main
      - sprint7/payments   # <--- add/remove branches as needed

jobs:
  ping-vercel:
    runs-on: ubuntu-latest
    steps:
      - name: Call Vercel Deploy Hook
        env:
          HOOK: ${{ secrets.VERCEL_DEPLOY_HOOK_URL }}
          BYPASS: ${{ secrets.VERCEL_AUTOMATION_BYPASS_SECRET }}
        run: |
          if [ -z "$HOOK" ]; then
            echo "Missing VERCEL_DEPLOY_HOOK_URL secret in repo settings" >&2
            exit 1
          fi
          # BYPASS is optional; header is only sent if provided
          if [ -n "$BYPASS" ]; then
            curl -fsSL -X POST "$HOOK" -H "x-vercel-protection-bypass: $BYPASS"
          else
            curl -fsSL -X POST "$HOOK"
          fi
