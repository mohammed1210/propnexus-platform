name: Deployment Preview

on:
  pull_request:

permissions:
  contents: read
  pull-requests: write  # allow commenting on PRs

jobs:
  verify-deploy:
    name: Verify Deployment
    runs-on: ubuntu-latest
    env:
      API_BASE: ${{ secrets.API_BASE }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Note API_BASE
        run: echo "Using API_BASE=${API_BASE:-<unset>}"

      - name: Run verify script
        if: env.API_BASE != ''
        run: |
          chmod +x scripts/verify-deploy.sh
          bash scripts/verify-deploy.sh "$API_BASE"

      # Only try to comment if this is a PR and token can write; continue on error.
      - name: Comment verification result
        if: always() && github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          github-token: ${{ github.token }}
          script: |
            const apiBase = process.env.API_BASE
            const message = apiBase
              ? 'Deployment verification completed.'
              : 'No API_BASE configured; skipped deployment verification.'
            try {
              await github.rest.issues.createComment({
                issue_number: context.issue.number,
                owner: context.repo.owner,
                repo: context.repo.repo,
                body: message
              })
            } catch (e) {
              core.warning(`Skipping PR comment: ${e.message}`)
            }
            