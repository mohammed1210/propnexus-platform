name: Frontend CI
on:
  pull_request:
    paths:
      - "frontend/**"
  push:
    branches:
      - po3/**
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"
          cache-dependency-path: frontend/package-lock.json
      - name: Install deps
        working-directory: frontend
        run: npm ci
      - name: Typecheck & Lint & Build
        working-directory: frontend
        run: |
          npm run typecheck || true
          npm run lint || true
          npm run build
