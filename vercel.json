{
  "buildCommand": "next build --webpack",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "env": {
    "NEXT_PUBLIC_FEATURE_AI_CHATBOT": "true"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "sprint-8": true,
      "sprint-8-updated": true,
      "*": true
    }
  }
}
