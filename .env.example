# Root .env (rarely used). Most variables live in:
#   - frontend/.env
#   - backend/.env
# This file exists only to avoid confusion; do not put secrets here.
PYTHONPATH=/app

# Common environment variables
# See frontend/.env.example and backend/.env.example for full configuration

# --- Production Deployment Variables ---
# These are typically set in your hosting provider (Vercel, Railway, etc.)
# NEXT_PUBLIC_APP_URL=https://propnexus-platform.vercel.app
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx (if using Clerk)
# CLERK_SECRET_KEY=sk_live_xxx (if using Clerk)

# Sprint 11.2: Frontend Feature Flags (NEXT_PUBLIC_* vars go in frontend/.env)
# NEXT_PUBLIC_API_BASE=http://localhost:8000
# NEXT_PUBLIC_FEATURE_AI_CHATBOT=true
# NEXT_PUBLIC_FEATURE_AI_DEAL_SCORE=true
# NEXT_PUBLIC_FEATURE_AREA_INTEL=true
# NEXT_PUBLIC_FEATURE_AREA_INSIGHTS=true
# NEXT_PUBLIC_FEATURE_COMPS=true

# --- Market intelligence / comps (backend) ---
AREA_INTEL_TTL_HOURS=168
COMPS_TTL_HOURS=168
GEO_PROVIDER=postcodes.io
GEO_TIMEOUT_SECONDS=10
CRIME_ENABLE=1
CRIME_TIMEOUT_SECONDS=12
RENT_COMPS_SOURCE=internal_properties
TRANSPORT_ENABLE=0
SCHOOLS_ENABLE=0
MARKET_INTEL_ALLOW_STUB=0

# Sprint 11.2: Subscription Tiers - Three tiers only (free, pro, investor)
# Enterprise tier has been removed
# STRIPE_PRICE_PRO=price_xxx (set in backend/.env)
# STRIPE_PRICE_INVESTOR=price_xxx (set in backend/.env)

# Sprint 11.2: Backend Secrets (go in backend/.env, never expose on client)
# OPENAI_API_KEY=sk-...
# CACHE_TTL_SECONDS=1800
# Canonical backend Supabase env names:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Scraper provider
SCRAPER_MODE=scraperapi
SCRAPERAPI_KEY=
RM_MAX_PAGES=1
RM_DELAY_MS=1200
RM_RENDER=0
OFF_MARKET_ADMIN_TOKEN=
