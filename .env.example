# Root .env (rarely used). Most variables live in:
#   - frontend/.env
#   - backend/.env
# This file exists only to avoid confusion; do not put secrets here.
PYTHONPATH=/app

# Common environment variables
# See frontend/.env.example and backend/.env.example for full configuration

