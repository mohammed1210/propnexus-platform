SUPABASE_URL=<supabase-url>
SUPABASE_KEY=<service-role-key>

# Stripe Configuration
STRIPE_SECRET_KEY=<sk_live_or_test_key>
STRIPE_WEBHOOK_SECRET=<webhook_secret>
STRIPE_SUCCESS_URL=https://propnexus-platform.vercel.app/billing/success
STRIPE_CANCEL_URL=https://propnexus-platform.vercel.app/billing/cancel

# Sprint 11: Stripe Price ID to Plan Mapping
STRIPE_PRICE_PRO=<price_xxx>       # Maps to "pro" plan
STRIPE_PRICE_INVESTOR=<price_yyy>  # Maps to "investor" plan
STRIPE_PRICE_ENTERPRISE=<price_zzz> # Maps to "enterprise" plan

# Email
EMAIL_FROM="PropNexus <no-reply@propnexus.app>"

# Sprint 11: AI Features (Backend - these are not NEXT_PUBLIC_*)
FEATURE_AI_CHATBOT=true
FEATURE_DEAL_SCORING=true
FEATURE_AREA_INTEL_PANEL=true
FEATURE_COMPS_PANEL=true
OPENAI_API_KEY=YOUR_KEY_HERE

# Optional: Cache TTL (defaults to 1800 seconds = 30 minutes)
CACHE_TTL_SECONDS=1800
