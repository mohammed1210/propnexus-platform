# Example environment file for the backend.
# Copy this file to `.env` and replace the values with your own.
# Do not commit secrets to version control.

# Secret key for session management or JWT signing
SECRET_KEY=change-me

# Database connection string (e.g. postgres://user:password@host:port/dbname)
DATABASE_URL=postgresql://user:password@localhost:5432/propnexus

# OpenAI API key for AI features
OPENAI_API_KEY=

# Allowed origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:3000

# Stripe secret key for billing (leave blank if unused)

# Mailer service credentials (optional)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
