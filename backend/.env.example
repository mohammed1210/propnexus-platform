# Optional local overrides for CORS/clients:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


SECRET_KEY=change-me
DATABASE_URL=postgresql://user:password@localhost:5432/propnexus
OPENAI_API_KEY=__SET_IN_DEPLOY_ENV__
ALLOWED_ORIGINS=http://localhost:3000
STRIPE_SECRET_KEY=__SET_IN_DEPLOY_ENV__
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
RESEND_API_KEY=


