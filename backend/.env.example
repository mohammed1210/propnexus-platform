# Example environment file for the backend
# Copy to .env and set real values locally; use Railway/Vercel for deploy secrets

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_KEY=your-service-role-key

# JWT secret for verifying Supabase tokens (found in Supabase Dashboard > Settings > API)
# This is typically the same as your JWT secret in Supabase project settings
SUPABASE_JWT_SECRET=your-jwt-secret

# Optional: for CORS/clients (usually set in frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Database (if using direct PostgreSQL connection) ---
DATABASE_URL=postgresql://user:password@localhost:5432/propnexus

# --- API Keys ---
OPENAI_API_KEY=sk-xxx
RESEND_API_KEY=re_xxx

# --- Stripe Configuration ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe price IDs for plan mapping (backend only)
# These map Stripe price IDs to plan tiers in the webhook handler
# Sprint 11.2: Limited to three tiers - free, pro, investor
# Unknown price IDs will NOT overwrite existing plans (preserves current tier)
# Sprint 11.2: Only free, pro, investor plans supported (enterprise removed)
STRIPE_PRICE_PRO=
STRIPE_PRICE_INVESTOR=

# --- Email (Legacy - use RESEND_API_KEY instead) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# --- Security ---
SECRET_KEY=your-secret-key-here

# --- CORS Configuration ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://propnexus-platform.vercel.app

# --- Optional: Site URLs ---
SITE_URL=https://propnexus-platform.vercel.app
PORTAL_RETURN_URL=https://propnexus-platform.vercel.app/account

# --- Scraper Configuration ---
# Scraper mode: 'direct', 'scraperapi', or 'smart'
# - direct: Direct HTTP requests with ScraperAPI fallback on blocking (default)
# - scraperapi: Always use ScraperAPI with rendering (most reliable, highest cost)
# - smart: Progressive fallback (direct → ScraperAPI no-render → ScraperAPI with render)
SCRAPER_MODE=direct
SCRAPERAPI_KEY=

# Rightmove scraper
RM_MAX_PAGES=1
RM_DELAY_MS=800

# Zoopla scraper
ZP_MAX_PAGES=1
ZP_DELAY_MS=900

# OnTheMarket scraper
OT_MAX_PAGES=1
OT_DELAY_MS=900

# SpareRoom scraper
SR_MAX_PAGES=1
SR_DELAY_MS=900

# --- Ingestion Runner ---
# Comma-separated list of UK locations to ingest per cycle
INGEST_LOCATIONS=London,Manchester,Liverpool,Birmingham
# Delay between full ingestion cycles in seconds (default 15 minutes)
INGEST_INTERVAL_SECONDS=900
# If set to 1, run exactly one cycle then exit (useful for one-off jobs)
INGEST_RUN_ONCE=0
# Sleep between individual location scrapes in a cycle (milliseconds)
INGEST_BATCH_SLEEP_MS=1500

# --- Playwright Dynamic Rendering (Optional) ---
# Enable to attempt a rendered fallback when static HTML yields zero results.
PLAYWRIGHT_ENABLE=0
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_TIMEOUT_MS=15000
