    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/leaflet": "^1.9.21",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "jose": "^6.1.2",
    "leaflet": "^1.9.4",
    "next": "^15.5.5",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.7",
    "stripe": "^19.1.0",
    "undici": "^6.21.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.3.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "19.2.2",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "web-streams-polyfill": "^4.2.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "validate-config": "node scripts/check-env.cjs",
    "ingest:csv": "tsx scripts/ingest-csv.ts data/listings.sample.csv --source=rightmove",
    "ingest:live": "tsx scripts/ingest-live.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "typecheck": "tsc --noEmit",
    "health:report": "node scripts/system-health-report.mjs",
    "test": "jest --passWithNoTests --testPathIgnorePatterns='e2e/'",
    "e2e": "playwright test --reporter=list"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "<rootDir>/frontend/e2e/"
    ]
  }
}
