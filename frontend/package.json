{
  "name": "propnexus-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "jest",
    "test:ci": "jest --ci --reporters=default",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "frontend:type-check": "cd frontend && tsc --noEmit",
    "frontend:build": "cd frontend && next build",
    "ingest:csv": "ts-node scripts/ingest-csv.ts data/listings.sample.csv",
    "e2e": "playwright test",
    "cypress:run": "cypress run",
    "e2e:prod": "npm run build && PW_USE_DEV=0 playwright test",
    "e2e:headed": "playwright test --headed",
    "smoke:stripe": "node ops/smoke/stripe-check.mjs",
    "screenshots": "SCREENSHOT_TEST=true playwright test tests/screenshots.spec.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.2.7",
    "@clerk/react": "^6.5.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@pdf-lib/upng": "^1.0.1",
    "@sentry/nextjs": "^10.40.0",
    "@sparticuz/chromium": "^143.0.4",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.104.1",
    "@swc/helpers": "0.5.21",
    "@vis.gl/react-google-maps": "^1.8.3",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "next": "^16.2.1",
    "next-intl": "^4.9.1",
    "openai": "^6.35.0",
    "pako": "^2.1.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.59.1",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-joyride": "^3.0.2",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.7",
    "stripe": "^22.0.1",
    "svix": "^1.93.0",
    "tslib": "^2.8.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/trusted-types": "^2.0.7",
    "autoprefixer": "^10.4.27",
    "babel-jest": "^30.4.1",
    "cypress": "^15.13.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.2",
    "web-streams-polyfill": "^4.2.0"
  },
  "overrides": {
    "leaflet": "^1.9.4"
  }
}
