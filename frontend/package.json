{
  "name": "propnexus-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "jest",
    "test:ci": "jest --ci --reporters=default",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "frontend:type-check": "cd frontend && tsc --noEmit",
    "frontend:build": "cd frontend && next build",
    "ingest:csv": "ts-node scripts/ingest-csv.ts data/listings.sample.csv",
    "e2e": "playwright test",
    "e2e:prod": "npm run build && PW_USE_DEV=0 playwright test",
    "e2e:headed": "playwright test --headed",
    "smoke:stripe": "node ops/smoke/stripe-check.mjs",
    "screenshots": "SCREENSHOT_TEST=true playwright test tests/screenshots.spec.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.35.2",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@pdf-lib/upng": "^1.0.1",
    "@sentry/nextjs": "^8.55.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.39.4",
    "@vis.gl/react-google-maps": "^1.7.1",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "html2pdf.js": "^0.12.1",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.9",
    "openai": "^5.16.0",
    "pako": "^2.1.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.7",
    "stripe": "^19.1.0",
    "svix": "^1.81.0",
    "tslib": "^1.14.1",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.12",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/trusted-types": "^2.0.7",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^30.2.0",
    "eslint": "8.45.0",
    "eslint-config-next": "^15.5.9",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.2",
    "postcss": "^8.5.6",
    "@tailwindcss/postcss": "^4.1.17",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.2",
    "web-streams-polyfill": "^3.3.3"
  },
  "overrides": {
    "leaflet": "^1.9.4"
  }
}
