# Example environment file for the frontend
# Copy this to .env.local for local development

# --- Supabase (Public) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (Server-side only) ---
# Required for admin dashboard and server-side operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- API Base URL ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Stripe (Public) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Stripe Price IDs ---
# Get these from your Stripe Dashboard
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_pro_xxx
NEXT_PUBLIC_STRIPE_PRICE_INVESTOR=price_investor_xxx

# --- Stripe Price Amounts (for admin dashboard MRR calculation) ---
# These should match the actual monthly amounts in your Stripe prices
NEXT_PUBLIC_STRIPE_AMOUNT_PRO=29
NEXT_PUBLIC_STRIPE_AMOUNT_INVESTOR=99

# --- Stripe (Server-side only) ---
# Required for webhook handling and checkout
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Optional Services ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_FEATURE_AI_DEAL_SCORE=
NEXT_PUBLIC_FEATURE_AI_SCORE_BREAKDOWN=
NEXT_PUBLIC_FEATURE_AI_CHATBOT=
NEXT_PUBLIC_FEATURE_AREA_INTEL=
NEXT_PUBLIC_FEATURE_COMPS_PANEL=
