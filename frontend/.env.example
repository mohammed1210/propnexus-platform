# Example environment file for the frontend
# Copy this to .env.local for local development

# --- Supabase (Public) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (Server-side only) ---
# Required for admin dashboard and server-side operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- API Base URL ---
# Backend API URL - used by frontend to fetch data
# For listings page: GET /properties
# For user plan: GET /users/plan?email=...
# For Stripe checkout: POST /stripe/create-checkout-session
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- App URL (Required for Production) ---
# Base URL of your deployed application
# Used for authentication redirects and callbacks
NEXT_PUBLIC_APP_URL=https://propnexus-platform.vercel.app

# --- Clerk Authentication (Optional - if migrating from Supabase) ---
# Get these from your Clerk Dashboard at https://dashboard.clerk.com
# Legacy note: previously used Supabase Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# Clerk Webhook Secret - Required for user sync to Supabase
# Get this from Clerk Dashboard -> Webhooks after creating the webhook endpoint
# Endpoint URL: https://your-domain.vercel.app/api/webhooks/clerk
# Events to subscribe to: user.created, user.updated
CLERK_WEBHOOK_SECRET=whsec_xxx

# Clerk redirect URLs after authentication
# These should match your NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Note: You must also configure these redirect URLs in the Clerk Dashboard:
# 1. Go to https://dashboard.clerk.com -> Your App -> Paths
# 2. Add redirect URL: https://propnexus-platform.vercel.app/dashboard
# 3. Add callback URL: https://propnexus-platform.vercel.app/api/auth/callback (if used)

# --- Stripe (Public) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Stripe Price IDs ---
# Get these from your Stripe Dashboard
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_pro_xxx
NEXT_PUBLIC_STRIPE_PRICE_INVESTOR=price_investor_xxx

# --- Stripe Price Amounts (for admin dashboard MRR calculation) ---
# These should match the actual monthly amounts in your Stripe prices
NEXT_PUBLIC_STRIPE_AMOUNT_PRO=29
NEXT_PUBLIC_STRIPE_AMOUNT_INVESTOR=99

# --- Stripe (Server-side only) ---
# Required for webhook handling and checkout
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Optional Services ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Feature Flags ---
# AI features are disabled by default for safety and cost control.
# Set to "true" or "1" to enable each feature individually.
# All flags default to false when not set.

# Enable AI-powered deal scoring (requires OpenAI API key in backend)
NEXT_PUBLIC_FEATURE_AI_DEAL_SCORE=false

# Enable detailed AI score breakdown and explanations
NEXT_PUBLIC_FEATURE_AI_SCORE_BREAKDOWN=false

# Enable AI chatbot for property investment advice (requires OpenAI API key in backend)
NEXT_PUBLIC_FEATURE_AI_CHATBOT=false

# Enable area intelligence panel with demographics and crime data
NEXT_PUBLIC_FEATURE_AREA_INTEL=false

# Enable comparable sales panel
NEXT_PUBLIC_FEATURE_COMPS=false

# --- Subscription Tiers ---
# The backend /users/plan endpoint now supports both:
# 1. Query parameter: ?email=user@example.com
# 2. Authorization header: Bearer <jwt-token>
# Sprint 11.2: Three tiers - free, pro, investor
# Ensure Stripe webhook is configured to update user tiers correctly.
